		{
			"name": "0. Health & Redis Connectivity",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200 OK\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"pm.test(\"Application and Redis are UP\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.status).to.eql(\"UP\");",
							"    pm.expect(jsonData.redis).to.eql(\"UP\");",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{rootUrl}}/health",
					"host": [
						"{{rootUrl}}"
					],
					"path": [
						"health"
					]
				},
				"description": "Verifies that the Spring Boot container is live and actively connected to Redis."
			},
			"response": []
		},
