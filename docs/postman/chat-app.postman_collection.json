		{
			"name": "5. Retrieve Chat History (Last 10) (Test Case 2)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200 OK\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"pm.test(\"Messages array returned in chronological order\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.messages).to.be.an(\"array\");",
							"    pm.expect(jsonData.messages.length).to.be.at.least(2);",
							"    pm.expect(jsonData.messages[0].participant).to.eql(\"guest_user\");",
							"    pm.expect(jsonData.messages[0].message).to.eql(\"Hello, world!\");",
