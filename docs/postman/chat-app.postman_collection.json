		{
			"name": "5. Retrieve Chat History (limit = 10)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200 OK\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"pm.test(\"Messages returned in chronological order\", function () {",
