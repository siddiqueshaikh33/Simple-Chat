	"item": [
		{
			"name": "1. Create Chat Room",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 201 Created\", function () {",
							"    pm.response.to.have.status(201);",
							"});",
							"pm.test(\"Response has success status and roomId\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.status).to.eql(\"success\");",
							"    pm.expect(jsonData.roomId).to.eql(\"general\");",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"roomName\": \"general\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/chatrooms",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"chatrooms"
					]
				},
				"description": "Creates a new chat room with unique roomName 'general'."
			},
			"response": []
		},
